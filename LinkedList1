class Node{
    Node next;
    int data;
    Node(int data,Node next){
        this.data=data;
        this.next=next;
    }
    Node(int data){
    this.data=data;
    this.next=null;
    }
}


    
     

    public class Main{
        private static  Node convertoLL(int arr[]){
    Node head=new Node(arr[0]);
    Node mover=head;
    for(int i=1;i<arr.length;i++)
    {
        Node temp=new Node(arr[i]);
        mover.next=temp;
        mover=mover.next;
    }
    return head;
        }
    public static void main(String[] args) 
    {
              int arr[]={11,3,4,5};
              Node head=convertoLL(arr);
              System.out.print(head.data);


    }
